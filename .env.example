# Runtime
APP_ENV=development
LOG_LEVEL=INFO
LOG_CONTENT_ENABLED=false
TELEMETRY_ENABLED=false

# Local data
DATABASE_URL=sqlite:///data/companion.db
DATA_RETENTION_DAYS=30

# LLM provider. Fake remains the free default. Never commit a real key.
LLM_PROVIDER=fake
LLM_MODEL=fake-mastery-v0.1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# For the required DeepSeek Vision experiment, use:
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash-vision-exp
