# Runtime
APP_ENV=development
LOG_LEVEL=INFO
LOG_CONTENT_ENABLED=false
TELEMETRY_ENABLED=false

# Local data
DATABASE_URL=sqlite:///data/companion.db
DATA_RETENTION_DAYS=30

# LLM provider. Sprint 0 defaults to the free deterministic fake provider.
LLM_PROVIDER=fake
LLM_MODEL=fake-mastery-v0.1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

