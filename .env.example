# Runtime
APP_ENV=development
LOG_LEVEL=INFO
LOG_CONTENT_ENABLED=false
TELEMETRY_ENABLED=false

# Local data
DATABASE_URL=sqlite:///data/companion.db
DATA_RETENTION_DAYS=30

# LLM provider. Fake remains the free default. Never commit a real key.
LLM_PROVIDER=fake
LLM_MODEL=fake-mastery-v0.1
LLM_API_KEY=
LLM_PAID_CALLS_ALLOWED=false
LLM_TIMEOUT_SECONDS=30

# Local Ollama routing (no API key required; keep Fake as the safe default).
# LLM_PROVIDER=ollama
# LLM_MODEL=gpt-oss:20b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_QUALITY_MODEL=gpt-oss:20b
# OLLAMA_BALANCED_MODEL=qwen3.5:4b
# OLLAMA_FAST_MODEL=qwen3.5:0.8b
# OLLAMA_TIMEOUT_SECONDS=300

# For the required DeepSeek Vision experiment, use:
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash-vision-exp
# LLM_PAID_CALLS_ALLOWED=true
